# ─────────────────────────────────────────────────────────────────────
# AquaWatch — environment variables
# Copy to .env and adjust DATABASE_URL for your setup.
# ─────────────────────────────────────────────────────────────────────

# ▼ MongoDB connection.
#
# IMPORTANT: Prisma's MongoDB connector requires a replica set (even a
# single-node one). The bundled docker-compose.yml sets this up for you;
# if you reuse an existing Mongo container you must enable rs there too.
#
# 1) Using the bundled docker-compose.yml (separate Mongo for this app):
#
DATABASE_URL="mongodb://localhost:27018/aquawatch?replicaSet=rs0&directConnection=true"

# 2) Reusing an existing MongoDB on your host that already has rs enabled:
#
# DATABASE_URL="mongodb://localhost:27017/aquawatch?replicaSet=rs0&directConnection=true"
#
# 3) Existing Mongo with authentication:
#
# DATABASE_URL="mongodb://USER:PASS@localhost:27017/aquawatch?authSource=admin&replicaSet=rs0&directConnection=true"
#
# Don't have replica set on your existing Mongo? Three options:
#   - Spin up the bundled one alongside (it uses port 27018, no clash)
#   - Reconfigure your existing container to start with --replSet rs0
#     and run rs.initiate() once
#   - Use MongoDB Atlas (free tier, always rs)

# Server secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-32-byte-random-hex-string"

# Session lifetime in days
AUTH_SESSION_DAYS=7

# ─────────────────────────────────────────────────────────────────────
# Web Push (phone / desktop browser notifications)
#
# Generate a fresh key pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public key is exposed to the browser via NEXT_PUBLIC_*. The private
# key MUST stay server-only — anyone with it can send pushes as you.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@aquawatch.dev"

# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3000/ws"
NEXT_PUBLIC_APP_NAME="AquaWatch"

# ─────────────────────────────────────────────────────────────────────
# Object storage for profile photos (MinIO / AWS S3 / Cloudflare R2 /
# Backblaze B2 — anything S3-compatible). Leave blank to disable uploads.
#
# Local MinIO (docker run -p 9000:9000 minio/minio server /data):
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="aquawatch"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
#
# AWS S3 (drop S3_ENDPOINT entirely):
# S3_REGION="us-east-1"
# S3_BUCKET="my-aquawatch-avatars"
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
